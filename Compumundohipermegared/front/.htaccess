<IfModule mod_rewrite.c>
RewriteEngine On

RewriteRule ^login/?$ dist/pages/login.html [L]
RewriteRule ^dashboard/?$ dist/pages/DashboardUsu.html [L]
RewriteRule ^dashboard-entrenador/?$ dist/pages/DashboardEntrenador.html [L]
RewriteRule ^dashboard-admin/?$ dist/pages/DashboardAdmin.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]
</IfModule>
